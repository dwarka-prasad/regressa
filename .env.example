# ---- Regressa environment ----
# Do not set NODE_ENV here: Next.js and the services set it themselves (a stray NODE_ENV=development breaks next build).

# Postgres + TimescaleDB (see infra/docker-compose.yml)
DATABASE_URL=postgres://regressa:regressa@localhost:5433/regressa_dev

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6380

# Ingestion API
INGEST_PORT=4100
INGEST_MAX_BATCH=500

# Dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3100

# Eval worker — LLM-as-judge and embeddings
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REGRESSA_JUDGE_MODEL=claude-sonnet-5
REGRESSA_EMBEDDING_MODEL=text-embedding-3-small

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Alert channels
SLACK_SIGNING_SECRET=
SMTP_URL=

# Dashboard URL used by the CLI gate and alert links
REGRESSA_APP_URL=http://localhost:3100
NEXT_PUBLIC_INGEST_URL=http://localhost:4100

# Email (alerts, weekly digest). smtp://user:pass@host:587 or smtps://...
SMTP_URL=
SMTP_FROM=Regressa <alerts@regressa.dev>

# Single sign-on (OIDC authorization code flow). Works with Okta, Auth0, Entra ID, Google, Keycloak.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
